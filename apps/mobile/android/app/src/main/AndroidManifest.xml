<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- All-files access: the app reads/writes a user-chosen repo root in shared
         storage that an external syncer (Syncthing/Dropbox/git) propagates. This
         heavy permission is a consequence of external sync (see addendum §A); it is
         granted by the user via the system "All files access" settings screen, not a
         runtime dialog. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Story 4.1: the AI features' Messages API calls need real network access.
         The debug/profile manifest overlays already declare this for Flutter's
         own tooling (hot reload), but that overlay is NOT present in a release
         build — without this line here, release builds could install and run
         but every AI call would fail with a permission denial. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Lore &amp; Story"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <!-- Story 4.1 review: allowBackup=false so the AI API key (secure
             storage, Android Keystore-encrypted) is never included in Android
             Auto Backup — matches this app's local-only security stance
             (NFR5). The only other affected app data is the small repo-root
             preference, easily re-chosen after a restore. -->
        <!-- Story 4.7 code review Decision 3: cleartext (http://) is needed
             for a `server: "custom"` AI endpoint on the author's own local
             network (e.g. LM Studio at http://192.168.x.x:1234) — Android
             denies cleartext by platform default from API 28 up. A
             range-restricted Network Security Config was the original plan,
             but Android's `<domain>` matcher only accepts exact hostnames or
             exact IP literals, never a CIDR range — there is no declarative
             way to say "any 192.168.0.0/16 address" for an author's
             not-yet-known LAN IP. The equivalent restriction is enforced
             instead in `ai/ai_server_config.dart`'s `resolveCustomOrigin`:
             `http://` is only ever accepted for a private/loopback host
             (RFC 1918 + 127.0.0.0/8 + 169.254.0.0/16); a public host is
             rejected there and must use `https://`. This blanket manifest
             flag only grants the OS-level *permission* to attempt cleartext
             at all — the app itself is what actually restricts where it's
             used. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
